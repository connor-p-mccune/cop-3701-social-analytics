# Copy to .env and adjust. docker compose and the Python app both read this file.

# Application schema. With Docker, this user is created on first start.
DB_USER=analytics
DB_PASSWORD=analytics_pw

# Easy Connect string: host:port/service_name
# Docker default is FREEPDB1; point this at any Oracle 12.1+ instance to use your own.
DB_DSN=localhost:1521/FREEPDB1

# Docker only: password for the SYS/SYSTEM accounts inside the container.
ORACLE_ADMIN_PASSWORD=change_me

# Optional: path to Oracle Instant Client. Leave unset to use python-oracledb's
# thin mode, which needs no client install. Only set for databases older than 12.1.
# ORACLE_CLIENT_LIB_DIR=/opt/oracle/instantclient_23_5
